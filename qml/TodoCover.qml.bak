import QtQuick 2.0
import Sailfish.Silica 1.0
import QtQuick.LocalStorage 2.0

CoverBackground {
    function antalAabne() {
        var db = LocalStorage.openDatabaseSync("todo8", "1.0", "Lister", 10000)
        var n = 0
        db.transaction(function (tx) {
            var r = tx.executeSql("SELECT COUNT(*) AS c FROM punkter WHERE faerdig = 0")
            if (r.rows.length > 0) n = r.rows.item(0).c
        })
        return n
    }

    Column {
        anchors.centerIn: parent
        spacing: Theme.paddingMedium

        Image {
            anchors.horizontalCenter: parent.horizontalCenter
            source: "file:///home/defaultuser/coding/todoapp/todoapp.png"
            width: Theme.iconSizeLarge
            height: width
        }

        Label {
            anchors.horizontalCenter: parent.horizontalCenter
            text: antalAabne() + " åbne gøremål"
            color: Theme.highlightColor
        }
    }
}
